# OpenAI or an OpenAI-compatible service. Never put keys in VITE_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
PORT=3001
# Alternatively, read agent.llm credentials from your private YAML without copying secrets:
# PRIVATE_LLM_CONFIG=~/.private/config.yaml
# OPENAI_MODEL=qwen-flash
# OPENAI_ENABLE_THINKING=false

# Local overlapping speech recognition (no audio sent to the LLM).
# ASR_PYTHON=/absolute/path/to/.data/asr-venv/bin/python
ASR_MODEL=base
ASR_THREADS=4
