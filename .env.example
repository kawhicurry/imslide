# OpenAI or an OpenAI-compatible service. Never put keys in VITE_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
PORT=3001
# Alternatively, read agent.llm credentials from your private YAML without copying secrets:
# PRIVATE_LLM_CONFIG=~/.private/config.yaml
# OPENAI_MODEL=qwen-flash
# OPENAI_ENABLE_THINKING=false

# MOSS recognition via SSH; recognized commands continue through the LLM tools.
ASR_PROVIDER=moss
MOSS_SSH_HOST=157
# Resolved on the remote SSH host. Current contract: GET /health, POST /infer.
MOSS_BASE_URL=http://127.0.0.1:18768
# MOSS requires local Silero VAD from scripts/asr-requirements.txt (no Whisper model download).
# Uses .data/asr-venv/bin/python when present; ASR_PYTHON overrides it.
# Optional local fallback: ASR_PROVIDER=whisper
# ASR_PYTHON=/absolute/path/to/.data/asr-venv/bin/python
ASR_MODEL=base
ASR_THREADS=4

# Continuous Volcengine/Ark Plan ASR; credentials stay on the server.
# ASR_PROVIDER=volc
# VOLC_ASR_API_KEY=
# Or a private UTF-8 file containing only the speech API key:
# VOLC_ASR_API_KEY_FILE=/absolute/private/path/speech-key
# VOLC_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/plan/sauc/bigmodel_async
# Resource ID is fixed to volc.seedasr.sauc.duration.
# Plan LLM (use the Plan key as OPENAI_API_KEY):
# OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
# OPENAI_MODEL=deepseek-v4.1-flash
# OPENAI_ENABLE_THINKING=false
