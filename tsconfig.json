{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@slidev/client": [
        "./src/slidev-api.d.ts"
      ],
      "@slidev/client/setup/*": [
        "./src/slidev-api.d.ts"
      ],
      "@slidev/client/internals/SlideWrapper.vue": [
        "./src/slidev-wrapper.d.ts"
      ],
      "@slidev/client/env.ts": [
        "./src/slidev-api.d.ts"
      ],
      "@slidev/client/composables/useClicks.ts": [
        "./src/slidev-api.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "imslide.ts",
    "tests/**/*.ts",
    "vite.config.ts"
  ]
}
