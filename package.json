{
  "name": "imslide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx watch imslide.ts --serve",
    "dev:slides": "node scripts/slides-compat.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "serve": "tsx imslide.ts --serve"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.0",
    "@slidev/cli": "52.20.1",
    "@slidev/client": "52.20.1",
    "@slidev/parser": "52.20.1",
    "@slidev/theme-default": "^0.25.0",
    "@slidev/types": "52.20.1",
    "ai": "^6.0.0",
    "dotenv": "^17.0.0",
    "express": "^5.0.0",
    "lucide-vue-next": "0.468.0",
    "undici": "^6.29.1",
    "vue": "3.5.42",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "6.0.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.13"
  }
}
