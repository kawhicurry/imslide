{
  "name": "imslide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx watch imslide.ts --serve",
    "dev:slides": "slidev slides/slides.md --port 3030 --remote= --bind 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "serve": "tsx imslide.ts --serve"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.0",
    "@slidev/cli": "^52.0.0",
    "@slidev/parser": "52.20.1",
    "@slidev/theme-default": "^0.25.0",
    "ai": "^6.0.0",
    "dotenv": "^17.0.0",
    "express": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "undici": "^6.29.1",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.0.0"
  }
}
